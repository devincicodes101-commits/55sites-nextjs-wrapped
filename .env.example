BASE44_APP_ID=6a3bc7b45c35bfaca5b859b3
BASE44_ENTITY=Lead

# --- crmazzy / Asbestos UK Teams CRM (create quotes there so it handles the
# branded quote, Accept button, choose-date/diary, and Quotes storage) ---
BASE44_CRM_APP_ID=6a27307f924688c6c670d92b
# BASE44_CRM_TOKEN=   (the CRM app api_key — set in Vercel, never commit)
# Asbestos UK Teams Service Catalog (detailed rates for AI quotes)
BASE44_CATALOG_APP_ID=6a27307f924688c6c670d92b
# BASE44_SERVICE_TOKEN=
# BASE44_API_TOKEN=

# --- Survey → Quote (*=all domains; or comma-separated city names) ---
SURVEY_QUOTE_PILOT_ENABLED=true
SURVEY_QUOTE_PILOT_CITIES=*
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Catalog-gap pricing (OpenAI) ---
# Prices survey works that are NOT in the fixed Service Catalog. Separate from
# GEMINI (extraction). If unset, catalog-gap items fall back to "manual quote
# required" instead of an estimated price.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Auto-email the generated quote (Resend)
# RESEND_API_KEY=re_xxx
QUOTE_FROM_EMAIL="Asbestos Teams <charlie@asbestosteams.com>"
# Hosted URL of the Asbestos UK Teams logo (PNG on dark bg) shown on quote emails.
# QUOTE_LOGO_URL=https://.../auk-logo.png
# Optional: where callback/contact fallback alerts go (defaults to QUOTE_FROM_EMAIL address)
# LEADS_NOTIFY_EMAIL=charlie@asbestosteams.com

# Optional backup store
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
